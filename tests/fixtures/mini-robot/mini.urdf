<?xml version="1.0"?>
<robot name="mini">
  <link name="base_link">
    <inertial><mass value="0.5"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="-0.02 -0.02 0" rpy="0 0 0"/><geometry><mesh filename="meshes/box.stl"/></geometry></visual>
  </link>
  <link name="arm_link">
    <inertial><mass value="0.1"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 -0.01 0"/><geometry><mesh filename="meshes/box.stl" scale="2 0.5 0.5"/></geometry></visual>
  </link>
  <joint name="pan" type="revolute">
    <parent link="base_link"/><child link="arm_link"/><origin xyz="0 0 0.04"/><axis xyz="0 0 1"/>
    <limit lower="-1.5" upper="1.5" effort="1" velocity="2"/>
  </joint>
</robot>
